{% if not loaded %}
  <div class="dimmed small">Loading ferry schedule…</div>
{% elif error %}
  <div class="dimmed small">Error: {{ error }}</div>
{% elif sailings.length == 0 %}
  <div class="dimmed small">No upcoming sailings today.</div>
{% else %}
  <div class="MMM-WaStateFerry-header medium">
    <!-- Ferry icon (pulses while fetching new data) -->
    <i class="fa-solid fa-ferry ferry-icon normal{% if fetching %} pulsing{% endif %}"></i>
    <span class="normal">{{ departingTerminalName }}</span>
    <span class="dimmed"> → </span>
    <span class="normal">{{ arrivingTerminalName }}</span>
  </div>
  <table class="MMM-WaStateFerry-table small">
    {% for sailing in sailings %}
    <tr class="{% if sailing.hasDeparted %}departed{% endif %}{% if sailing.isCancelled %} cancelled{% endif %}"{% if sailing.opacity != null %} style="opacity: {{ sailing.opacity }};"{% endif %}>
      <!-- Scheduled Time -->
      <td class="departure-time normal">{{ sailing.departingTime }}</td>

      <!-- Estimated Departure Time (italic, colored by delay); departed sailings show "Dep:", not italic -->
      <td class="estimated-time">
        {% if sailing.isCancelled %}
          <span class="dimmed">N/A</span>
        {% elif sailing.hasDeparted %}
          <!-- Actual departure time when known, otherwise the estimate -->
          <span class="dimmed departed-time">Dep: {{ sailing.departedTime }}</span>
        {% elif sailing.delayMinutes > 0 %}
          <span class="dimmed {{ sailing.delayClass }}" title="Delayed by {{ sailing.delayMinutes }} mins">Est: {{ sailing.estDeptTime }}</span>
        {% else %}
          <span class="dimmed">{{ sailing.estDeptTime }}</span>
        {% endif %}
      </td>

      <!-- Drive-up spaces left (upcoming: live, italic, colored; departed: last count seen; N/A when not available) -->
      <td class="spaces dimmed {{ sailing.spaceClass }}"><i class="fa-solid fa-car space-icon"></i><span class="space-count">{% if not sailing.isCancelled and sailing.driveUpSpaceCount != null %}{{ sailing.driveUpSpaceCount }}{% else %}N/A{% endif %}</span></td>

      <!-- Vessel Name (N/A for cancelled sailings) -->
      <td class="vessel-name dimmed">{% if sailing.isCancelled %}N/A{% else %}{{ sailing.vesselName }}{% endif %}</td>
    </tr>
    {% endfor %}

    <!-- Last Updated Footer (not faded) -->
    {% if lastUpdated %}
    <tr class="last-updated-row">
      <td colspan="4" class="last-updated dimmed">last updated on {{ lastUpdated }}</td>
    </tr>
    {% endif %}
  </table>
{% endif %}
